# Copiar a .env y ajustar si hace falta. Estos valores los usan tanto
# docker-compose.yml (contenedor db) como app/config.py (contenedor api).

POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex
# Puerto expuesto en el host para psql/clientes externos. Cambiar si
# ya tienes un Postgres local escuchando en 5432.
POSTGRES_PORT=5432

# Sembrar admin/estudiante al arrancar si la tabla users está vacía.
SEED_DEMO_USERS=true
